<style>
  .search-btn {
    background-color: #fe424d;
    color:#fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }
  .search-btn:hover {
    background-color: #fe424d;
    color:#fff;
  }
  .search-btn i{
    display: inline;
    margin-right: 0.5rem;
  }
  .search-input{
    border-radius: 25px;
    font-size: 1rem;
  }
</style>
<nav class="navbar navbar-expand-md navbar-light bg-white border-bottom fixed-top shadow-sm py-2 px-3">
<div class="container-fluid">
<!-- MOBILE TOGGLE -->
